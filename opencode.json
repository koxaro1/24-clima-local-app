{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "*firebase-adminsdk*": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "deny",
      ".opencode/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": { "*": "deny" },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "npm install*": "ask",
      "npm i *": "ask",
      "curl *": "deny",
      "wget *": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "vercel*": "deny",
      "eas *": "deny"
    },
    "webfetch": "deny",
    "task": "deny"
  }
}
